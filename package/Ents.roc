## The HTML5 named character references, and the numeric ones.
##
## GENERATED from https://html.spec.whatwg.org/entities.json — the 2125 names
## that require a trailing semicolon. The legacy semicolon-less forms
## (`&amp` without one) are deliberately absent: CommonMark requires the
## semicolon, and admitting the others would turn every `&copy` in prose into a
## character.
##
## The table is a flat list searched linearly. That is O(table) per entity and
## it does not matter — a document has a handful of entities
Ents := [].{
    Ent : { n : Str, c : Str }

    ## **The table every lookup in this package reads, and the one line to edit
    ## to shrink a build.**
    ##
    ## `Ents.full` is the whole HTML5 set; `Ents.minimal` is the five XML
    ## predefined references. Point this at `Ents.minimal` and the other table
    ## is unreferenced, so nothing links it.
    ##
    ## It is a source edit rather than a parameter on purpose. Threading the
    ## choice through the parser meant an extra refcounted argument on about
    ## thirty functions, and that CODE cost most of what dropping the table
    ## saved — the profile is in the README. A build-time constant costs
    ## nothing and reaches every caller, including the ones inside this module
    ## that a public parameter could never have reached.
    table : List(Ents.Ent)
    table = Ents.full

    ## Decode every entity in a string. For the places that are not scanned
    ## character by character — a link destination, a title, a fence's info
    ## string — which are exactly the places entities were being missed.
    decode : Str -> Str
    decode = |t|
        if t.contains("&") {
            Str.from_utf8_lossy(Ents.walk(Str.to_utf8(t), 0, []))
        } else {
            t
        }

    walk : List(U8), U64, List(U8) -> List(U8)
    walk = |b, i, out|
        if i >= List.len(b) {
            out
        } else if List.get(b, i) == Ok(38) {
            match Ents.semi(b, i + 1) {
                Ok(close) =>
                    match Ents.lookup(Str.from_utf8_lossy(List.sublist(b, { start: i + 1, len: close - i - 1 }))) {
                        Ok(ch) => Ents.walk(b, close + 1, List.concat(out, Str.to_utf8(ch)))
                        Err(_) => Ents.walk(b, i + 1, List.append(out, 38))
                    }
                Err(_) => Ents.walk(b, i + 1, List.append(out, 38))
            }
        } else {
            match List.get(b, i) {
                Ok(c) => Ents.walk(b, i + 1, List.append(out, c))
                Err(_) => out
            }
        }

    semi : List(U8), U64 -> Try(U64, [NotFound])
    semi = |b, i|
        if i >= List.len(b) {
            Err(NotFound)
        } else if List.get(b, i) == Ok(59) {
            Ok(i)
        } else {
            Ents.semi(b, i + 1)
        }

    lookup : Str -> Try(Str, [NotFound])
    lookup = |name|
        if name.starts_with("#") {
            Ents.numeric(name)
        } else {
            match List.find_first(Ents.table, |e| e.n == name) {
                Ok(e) => Ok(e.c)
                Err(_) => Err(NotFound)
            }
        }

    ## `&#35;` and `&#x22;`. A zero codepoint is U+FFFD, not a NUL — the spec
    ## is explicit, and emitting a NUL would corrupt the output string.
    ##
    ## The digit count is checked BEFORE anything is accumulated. The range test
    ## below cannot guard the arithmetic: twenty decimal digits overflow a U64
    ## on the way to a value, and Roc traps on overflow, so the parse crashed
    ## instead of leaving the text literal.
    numeric : Str -> Try(Str, [NotFound])
    numeric = |name| {
        body = name.drop_prefix("#")
        hex_body = Str.from_utf8_lossy(List.drop_first(Str.to_utf8(body), 1))
        cp = if (body.starts_with("x") or body.starts_with("X")) and !Str.is_empty(hex_body) {
            if Str.count_utf8_bytes(hex_body) > Ents.max_hex_digits {
                Err(NotFound)
            } else {
                Ents.hex_value(Str.to_utf8(hex_body), 0)
            }
        } else if Ents.all_digits(Str.to_utf8(body)) and Str.count_utf8_bytes(body) <= Ents.max_dec_digits {
            Ok(Ents.dec_value(Str.to_utf8(body), 0))
        } else {
            Err(NotFound)
        }
        match cp {
            Ok(0) => Ok("\u(FFFD)")
            ## Out of range is not a reference at all — it stays literal rather
            ## than becoming a replacement character.
            Ok(n) =>
                if n > 1114111 {
                    Err(NotFound)
                } else {
                    Ok(Ents.encode(n))
                }
            Err(_) => Err(NotFound)
        }
    }

    ## The spec's limits on a numeric reference: `&#` and 1-7 decimal digits,
    ## `&#x` and 1-6 hex digits. Seven decimal digits cannot exceed a U64, and
    ## neither can six hex ones.
    max_dec_digits : U64
    max_dec_digits = 7

    max_hex_digits : U64
    max_hex_digits = 6

    all_digits : List(U8) -> Bool
    all_digits = |b|
        !List.is_empty(b) and List.len(List.keep_if(b, |c| c >= 48 and c <= 57)) == List.len(b)

    dec_value : List(U8), U64 -> U64
    dec_value = |b, acc|
        match List.first(b) {
            Ok(c) => Ents.dec_value(List.drop_first(b, 1), acc * 10 + (c - 48).to_u64())
            Err(_) => acc
        }

    hex_value : List(U8), U64 -> Try(U64, [NotFound])
    hex_value = |b, acc|
        match List.first(b) {
            Ok(c) => {
                d = if c >= 48 and c <= 57 {
                    Ok((c - 48).to_u64())
                } else if c >= 97 and c <= 102 {
                    Ok((c - 87).to_u64())
                } else if c >= 65 and c <= 70 {
                    Ok((c - 55).to_u64())
                } else {
                    Err(NotFound)
                }
                match d {
                    Ok(v) => Ents.hex_value(List.drop_first(b, 1), acc * 16 + v)
                    Err(_) => Err(NotFound)
                }
            }
            ## An EMPTY run of digits is not a reference: `&#x;` is literal
            ## text, not U+FFFD.
            Err(_) => Ok(acc)
        }

    ## Codepoint to UTF-8, by arithmetic rather than bit operations — the
    ## shifts and masks are the same thing and this needs no API guessed at.
    encode : U64 -> Str
    encode = |cp|
        if cp < 128 {
            Str.from_utf8_lossy([cp.to_u8_wrap()])
        } else if cp < 2048 {
            Str.from_utf8_lossy([(192 + cp / 64).to_u8_wrap(), (128 + cp % 64).to_u8_wrap()])
        } else if cp < 65536 {
            Str.from_utf8_lossy(
                [(224 + cp / 4096).to_u8_wrap(), (128 + (cp / 64) % 64).to_u8_wrap(), (128 + cp % 64).to_u8_wrap()],
            )
        } else if cp <= 1114111 {
            Str.from_utf8_lossy(
                [
                    (240 + cp / 262144).to_u8_wrap(),
                    (128 + (cp / 4096) % 64).to_u8_wrap(),
                    (128 + (cp / 64) % 64).to_u8_wrap(),
                    (128 + cp % 64).to_u8_wrap(),
                ],
            )
        } else {
            "\u(FFFD)"
        }

    ## The five XML predefined references, and nothing else.
    ##
    ## For builds that care more about size than about `&hellip;`. These five are
    ## not a taste judgement: they are the ones whose decoding is SEMANTIC rather
    ## than cosmetic — `&lt;` must not go on to open a tag, `&amp;` must not go
    ## on to open another entity. Everything else in the full table maps to a
    ## character that renders as itself either way, so a document using one
    ## degrades to showing `&hellip;` rather than to being misparsed.
    ##
    ## Numeric references are unaffected in both profiles: `&#42;` is decoded by
    ## `numeric`, which is code and carries no table.
    minimal : List(Ents.Ent)
    minimal = [
        { n: "amp", c: "&" },
        { n: "lt", c: "<" },
        { n: "gt", c: ">" },
        { n: "quot", c: "\"" },
        { n: "apos", c: "'" },
    ]

    ## Every HTML5 named character reference that requires a semicolon.
    full : List(Ents.Ent)
    full = [
